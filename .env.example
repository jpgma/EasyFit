# Copie para .env. Nunca versione o arquivo .env.

# Domínio público servido pelo Caddy. Use localhost para testar localmente.
DOMAIN=localhost

# Senha do PostgreSQL. Gere uma senha forte para produção.
DB_PASSWORD=troque-esta-senha

# Deve usar a mesma senha de DB_PASSWORD.
DB_CONNECTION=Host=db;Port=5432;Database=easyfit;Username=easyfit;Password=troque-esta-senha

# Imagem da aplicação.
EASYFIT_IMAGE=easyfit:latest

# Diretório persistente com os dados do PostgreSQL e as evidências.
DATA_DIR=/srv/easyfit
