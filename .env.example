# Copie para .env. Nunca versione o arquivo .env.

# Domínio público servido pelo Caddy. Use localhost para testar localmente.
DOMAIN=localhost

# Senha do PostgreSQL. Gere uma senha forte para produção.
DB_PASSWORD=troque-esta-senha

# Deve usar a mesma senha de DB_PASSWORD.
DB_CONNECTION=Host=db;Port=5432;Database=wrexercise;Username=wrexercise;Password=troque-esta-senha

# Permite criar contas. Deixe em false, exceto para criar a primeira conta:
# ligue, recrie o serviço app, crie a conta, desligue e recrie o serviço de novo.
CADASTRO_ABERTO=false

# Imagem da aplicação.
WREXERCISE_IMAGE=wrexercise:latest

# Diretório persistente com os dados do PostgreSQL e as evidências.
DATA_DIR=/srv/wrexercise

# Destino dos backups (deploy/backup.sh). Para ter cópia fora da máquina, use uma pasta
# sincronizada com outro lugar ou copie os arquivos regularmente.
BACKUP_DIR=/srv/wrexercise/backups
