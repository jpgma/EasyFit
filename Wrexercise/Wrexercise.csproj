<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Wrexercise</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- O Caddy comprime as respostas; não há por que gerar .gz e .br no build. -->
    <CompressionEnabled>false</CompressionEnabled>
    <!-- A imagem de produção não leva símbolos de depuração (Wrexercise.dbg). -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <!-- O frontend é um projeto Node à parte; sem isto, node_modules entraria na publicação. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);webapp/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Database\Migrations\*.sql" LogicalName="Migrations/%(Filename)%(Extension)" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <InternalsVisibleTo Include="Wrexercise.UnitTests" />
    <InternalsVisibleTo Include="Wrexercise.IntegrationTests" />
  </ItemGroup>

</Project>
